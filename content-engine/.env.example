# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# ── Postgres ────────────────────────────────────────────────
POSTGRES_PASSWORD=
CONTENT_DB_PASSWORD=
N8N_DB_PASSWORD=

# ── Backend ─────────────────────────────────────────────────
# host user that owns ./inbox (id -u)
CONTENT_UID=1000
# (id -g)
CONTENT_GID=1000
# n8n -> backend
INTERNAL_SERVICE_TOKEN=
# me -> /admin
ADMIN_TOKEN=
# signs one-click approve/reject links
APPROVAL_LINK_SECRET=
# backend -> n8n
N8N_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://abdulazeez.usaiy.xyz
PUBLIC_API_URL=https://api.usaiy.xyz
NOTIFY_EMAIL_TO=abdulazeezyisau@gmail.com

# ── Email (dev: the Mailpit override replaces these) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Callmehalpha Content Engine <no-reply@usaiy.xyz>"

# ── n8n ─────────────────────────────────────────────────────
# back this up: losing it loses every saved credential
N8N_ENCRYPTION_KEY=
N8N_HOST=n8n.usaiy.xyz
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.usaiy.xyz
N8N_WEBHOOK_URL=https://n8n.usaiy.xyz

# ── Caddy (docker compose --profile production up) ──────────
API_DOMAIN=api.usaiy.xyz
N8N_DOMAIN=n8n.usaiy.xyz
N8N_EDITOR_USER=admin
# docker run --rm caddy:2-alpine caddy hash-password --plaintext '...'
# Paste it in single quotes, e.g. N8N_EDITOR_PASSWORD_HASH='$2a$14$...', or compose expands the $ signs.
N8N_EDITOR_PASSWORD_HASH=
# Serve the portfolio through this Caddy too (node server.mjs on the host). Leave unset if another proxy serves it.
PORTFOLIO_DOMAIN=
PORTFOLIO_UPSTREAM=host.docker.internal:3003
